{
  "name": "generator-smluv-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ci": "eslint app lib e2e scripts/generate-samples.ts scripts/i18n-expat-tests.ts scripts/checkout-flow-audit.ts scripts/pre-deploy-expat-check.ts scripts/lint-contracts.ts scripts/audit-pre-deploy-pdfs.ts --quiet",
    "test:i18n": "tsx scripts/i18n-expat-tests.ts",
    "test:e2e:i18n": "tsx scripts/i18n-expat-tests.ts",
    "test:pdf:i18n": "tsx scripts/i18n-expat-tests.ts",
    "test:e2e": "playwright test",
    "test:e2e:lease-en": "playwright test e2e/lease-en-smoke.spec.ts",
    "test:e2e:lease-ua": "playwright test e2e/lease-ua-smoke.spec.ts",
    "test:e2e:lease-expat": "playwright test e2e/lease-en-smoke.spec.ts e2e/lease-ua-smoke.spec.ts",
    "test:pre-deploy": "npm run lint:ci && tsx scripts/i18n-expat-tests.ts && tsx scripts/checkout-flow-audit.ts && tsx scripts/pre-deploy-expat-check.ts && tsx scripts/lint-contracts.ts && npm run build"
  },
  "dependencies": {
    "@upstash/redis": "^1.37.0",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.0.1",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^20.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "pdf-parse": "^1.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
