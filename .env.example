# SmlouvaHned — požadované proměnné prostředí
# Zkopírujte tento soubor do .env.local a vyplňte hodnoty

# === STRIPE ===
# Tajný klíč z Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...

# Webhook signing secret — z Stripe Dashboard → Developers → Webhooks
# Pro lokální vývoj použijte Stripe CLI: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs z Stripe Dashboard → Product catalog
# Základní dokument (99 Kč)
STRIPE_PRICE_ID_BASIC=price_...
# Komplexní balíček (199 Kč)
STRIPE_PRICE_ID_PREMIUM=price_...
# Profesionální balíček — volitelný 3. tier (pokud se nepoužívá, nastavte stejnou hodnotu jako PREMIUM)
STRIPE_PRICE_ID_PRO=price_...
# Tematický balíček pronajímatel / prodej vozidla (299 Kč)
STRIPE_PRICE_ID_PACKAGE=price_...
# Personální balíček Zaměstnavatel Start 2026 (599 Kč)
STRIPE_PRICE_ID_EMPLOYER_START=price_...
# Balíček Zakázka Plus ke smlouvě o dílo (399 Kč)
# Musí být nastaveno současně s NEXT_PUBLIC_FEATURE_ZAKAZKA_PLUS=true,
# jinak checkout balíčku skončí chybou konfigurace ceny.
STRIPE_PRICE_ID_WORK_ORDER=price_...

# Tajný serverový klíč pro ručně spuštěný live checkout audit.
# Nesmí mít prefix NEXT_PUBLIC_; audit jej posílá pouze v interním HTTP headeru.
CHECKOUT_AUDIT_SECRET=generate-a-long-random-value

# === UPSTASH REDIS ===
# REST URL z Upstash Console → vyberte databázi → REST API
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io

# REST Token z Upstash Console
UPSTASH_REDIS_REST_TOKEN=AXxx...

# === RESEND (volitelné) ===
# API klíč z Resend Dashboard — bez tohoto klíče se e-maily neodesílají,
# platba a stažení dokumentu fungují i bez něj
RESEND_API_KEY=re_...

# === APLIKACE ===
# Produkční URL bez trailing slash — vždy s www (kanonická doména, sitemap, metadata)
NEXT_PUBLIC_BASE_URL=https://www.smlouvahned.cz

# === MONETIZAČNÍ FEATURE FLAGY ===
# Pouze přepínače viditelnosti UI. Nepatří sem žádný secret — ceny a Stripe
# Price ID zůstávají v serverových proměnných výše.
# Výchozí stav každého flagu je vypnuto; hodnotu „true" nastavte teprve tehdy,
# až je odpovídající produkt nebo partnerská URL skutečně připravena.

# Balíček Zakázka Plus (399 Kč). Vyžaduje STRIPE_PRICE_ID_WORK_ORDER.
NEXT_PUBLIC_FEATURE_ZAKAZKA_PLUS=false
# Rozšířený obsah balíčku pro prodej vozidla (plná moc k přepisu + checklist).
# Cena balíčku zůstává 299 Kč, používá stávající STRIPE_PRICE_ID_PACKAGE.
NEXT_PUBLIC_FEATURE_CAR_SALE_COMPLETE=false
# Roční plán pro pronajímatele. Bez recurring backendu musí zůstat vypnutý.
NEXT_PUBLIC_FEATURE_LANDLORD_ANNUAL=false
# Navazující nabídka elektronického podpisu po zaplacení.
NEXT_PUBLIC_FEATURE_ESIGN_OFFER=false
# Navazující nabídka prověření historie vozidla po zaplacení.
NEXT_PUBLIC_FEATURE_VEHICLE_HISTORY_OFFER=false

# Cílové odkazy navazujících nabídek. Bez nich se nabídka nezobrazí ani se
# zapnutým flagem. Je-li odkaz partnerský (provizní), nastavte příznak níže,
# aby se v UI zobrazilo označení „Partnerský odkaz".
NEXT_PUBLIC_ESIGN_OFFER_URL=
NEXT_PUBLIC_ESIGN_OFFER_IS_AFFILIATE=false
NEXT_PUBLIC_VEHICLE_HISTORY_OFFER_URL=
NEXT_PUBLIC_VEHICLE_HISTORY_OFFER_IS_AFFILIATE=false

# === INTERNÍ REPORTING ===
# Tajný řetězec pro přístup na /interni/analytics?secret=<hodnota>
# Bez tohoto klíče je stránka nedostupná (vrátí 404)
INTERNAL_REPORTING_SECRET=nastavte-silny-tajny-retezec
